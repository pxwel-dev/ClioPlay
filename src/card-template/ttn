# saved-phone reconnect can proceed in parallel with vehicle/GPS acquisition.
# btstart preserves its own Renault-HID quiet window and publishes /tmp/clbtrdy
# only when the Bluetooth core is safe for the daemon to reconnect.
CLIO_DEBUG=$DEBUG /bin/sh $SD/clio843/btstart.sh >/dev/null 2>&1 &
log "BT START REQUESTED EARLY (GPS-INDEPENDENT)"

# 3) Replace the Focus endpoint, then reconnect the stock vehicle daemon.
# focusd publishes /tmp/cfstate plus a volatile /tmp/cfbus event stream.
killall focusd >/dev/null 2>&1
$SD/clio843/focusd >/dev/null 2>&1 &
log "FOCUS START REQUESTED"
N=0
while [ $N -lt 8 ]; do
