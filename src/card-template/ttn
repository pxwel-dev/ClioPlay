    AUX_MD5=${AUX_MD5%% *}
    if [ "$AUX_MD5" != "008bc35e334b6b71f9ebac76d542d266" ]; then
      AUX_RC=126
      echo "AUX embedded checksum FAILED: ${AUX_MD5:-unavailable}"
      return 0
    fi
    echo "AUX EMBEDDED CHECKSUM OK"
    if chmod 700 "$AUX_INIT"; then
      "$AUX_INIT"
      AUX_RC=$?
    else
      AUX_RC=126
      echo "AUX initializer chmod failed: $AUX_INIT"
    fi
  else
    AUX_RC=127
    echo "AUX initializer extraction failed: $AUX_INIT"
  fi
